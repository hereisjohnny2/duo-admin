# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# (Dashboard -> Project Settings -> API)

# ---------- URL do projeto ----------
# ex.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# ---------- Auth (browser) — chave PÚBLICA ----------
# anon key OU publishable key (sb_publishable_...). Usada no login (cliente).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- Dados (servidor) — chave SECRETA ----------
# service_role (clássica) OU secret key (nova, sb_secret_...).
# Só no servidor; NÃO prefixe com NEXT_PUBLIC_ e NÃO use a publishable/anon aqui.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Backup semanal em CSV (Vercel Cron) — só no servidor ----------
# Segredo que a Vercel envia nas chamadas do cron (Authorization: Bearer ...).
# Sem ele, /api/cron/backup recusa qualquer chamada. Gere com: openssl rand -hex 32
CRON_SECRET=
